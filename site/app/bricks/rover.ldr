0 // A small driving robot, built only from parts of the LEGO Education SPIKE Prime set (45678).
0 // Cables (not drawn): the motors to ports A and B, the distance sensor to port C.

0 // Hub
1 71 0 0 0 -1 0 0 0 1 0 0 0 -1 45601c01.dat
0 STEP
0 // Right motor: two blue 3L pins into the side of the hub, then the motor
1 1 -80 -10 -80 -1 0 0 0 1 0 0 0 -1 6558.dat
1 1 -80 -50 -80 -1 0 0 0 1 0 0 0 -1 6558.dat
1 15 -100 -30 -80 0 1 0 -1 0 0 0 0 1 54696p01.dat
0 STEP
0 // Left motor
1 1 80 -10 -80 -1 0 0 0 1 0 0 0 -1 6558.dat
1 1 80 -50 -80 -1 0 0 0 1 0 0 0 -1 6558.dat
1 15 100 -30 -80 0 -1 0 1 0 0 0 0 1 54696p01.dat
0 STEP
0 // Right wheel on a 3L axle
1 71 -155 -30 -80 -1 0 0 0 1 0 0 0 -1 4519.dat
1 15 -167.5 -30 -80 0 0 -1 0 1 0 1 0 0 39367p01.dat
0 STEP
0 // Left wheel on a 3L axle
1 71 155 -30 -80 -1 0 0 0 1 0 0 0 -1 4519.dat
1 15 167.5 -30 -80 0 0 1 0 1 0 -1 0 0 39367p01.dat
0 STEP
0 // Back: a 7L beam with two blue 3L pins
1 1 -40 -30 120 0 0 1 0 1 0 -1 0 0 6558.dat
1 1 40 -30 120 0 0 1 0 1 0 -1 0 0 6558.dat
1 15 0 -30 120 0 0 -1 1 0 0 0 -1 0 32524.dat
0 STEP
0 // Ball caster on the pins
1 71 0 -30 140 0 0 1 0 1 0 -1 0 0 39370c01.dat
0 STEP
0 // Front: a 7L beam with two black pins
1 0 -40 -30 -110 0 0 1 0 1 0 -1 0 0 2780.dat
1 0 40 -30 -110 0 0 1 0 1 0 -1 0 0 2780.dat
1 15 0 -30 -120 0 0 -1 1 0 0 0 -1 0 32524.dat
0 STEP
0 // Distance sensor: two black pins in the outer holes, then the sensor
1 0 -60 -30 -130 0 0 1 0 1 0 -1 0 0 2780.dat
1 0 60 -30 -130 0 0 1 0 1 0 -1 0 0 2780.dat
1 15 0 -30 -140 1 0 0 0 1 0 0 0 1 37316.dat
0 STEP
